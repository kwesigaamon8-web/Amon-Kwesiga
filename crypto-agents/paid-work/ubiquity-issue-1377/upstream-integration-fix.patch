+test("identical relative countdowns 14 seconds apart preserve the snapshot and inode", async () => {
+  await withStatusLine(async (directory, send) => {
+    const observedAt = Date.now() - 14_000;
+    const previous = { version: 1, observed_at_ms: observedAt, ...projectAntigravityStatusLine(EVENT) };
+    const destination = join(directory, GEMINI_QUOTA_FILE);
+    await writeFile(destination, JSON.stringify(previous), { mode: 0o600 });
+    const originalInode = (await lstat(destination)).ino;
+
+    await send(EVENT);
+    assert.deepEqual(await readGeminiQuotaSnapshot(directory), previous);
+    assert.equal((await lstat(destination)).ino, originalInode);
+
+    // A true countdown change must still replace the stored data.
+    const changed = { ...EVENT, quota: { weekly: { ...EVENT.quota.weekly, reset_in_seconds: 7210 } } };
+    await send(changed);
+    const updated = await readGeminiQuotaSnapshot(directory);
+    assert.equal(updated.status, "observed");
+    assert.ok(updated.observed_at_ms > observedAt);
+    assert.deepEqual(updated.quota, changed.quota);
+  });
+});
